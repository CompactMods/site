@page "/wiki";
@using Web.Services
@inject ProjectsService Projects

<h1>Wiki Home</h1>

@if (_projectList is not null)
{
    if (_projectList.Count > 0)
    {
        <p>Please choose a mod to view its wiki pages:</p>
        <ul>
            @foreach (var proj in _projectList)
            {
                <li><a href="/wiki/@proj.Slug">@proj.Name</a></li>
            }
        </ul>
    } else
    {
        <p>There are no projects to list. Please try again later.</p>
    }
} else
{
    <p>Loading projects, please wait...</p>
}

@code {
    private ICollection<ProjectsService.Project>? _projectList;

    protected override async Task OnInitializedAsync()
    {
        _projectList = await Projects.GetProjects();
    }
}