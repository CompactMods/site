@page "/wiki/{project}/{*route}"
@using Markdig
@using Markdig.Prism
@using Web.Services

@inject ProjectsService Projects
@inject WikiService Wiki
@inject NavigationManager Nav

<PageTitle>Wiki</PageTitle>

@if (IsErrored)
{
    <p>There was an error loading this page. Please reload the page to try again, or <a href="/wiki">go back to the wiki root</a>.</p>
    @if (!string.IsNullOrEmpty(CustomError))
    {
        <p><b>Error:</b> @CustomError</p>
    }
}
else
{
    @if (IsLoading)
    {
        <SectionalLoader Message="Loading page…" Height="60vh" />
    }
    else
    {
        <header class="wiki-header">
            <h1 class="wiki-title">@ProjectName</h1>

            @if (WikiProject is { IsVersioned: true })
            {
                <label class="wiki-version">
                    <span class="wiki-version-label">Version</span>
                    <select class="wiki-version-select" value="@Version!.Slug" @onchange="OnVersionChanged">
                        @foreach (var v in WikiProject.Versions)
                        {
                            <option value="@v.Slug">@v.Label</option>
                        }
                    </select>
                </label>
            }
        </header>

        <div class="wiki-page">
            <aside class="wiki-sidebar">
                @if (GlobalPages.Count > 0)
                {
                    <nav class="wiki-nav wiki-nav-global" aria-label="General pages">
                        <span class="wiki-nav-heading">General</span>
                        @PageList(GlobalPages)
                    </nav>
                }

                @if (VersionPages.Count > 0)
                {
                    <nav class="wiki-nav" aria-label="@(Version!.Slug is null ? "Pages" : $"{Version.Name} pages")">
                        @if (Version!.Slug is not null)
                        {
                            <span class="wiki-nav-heading">@Version.Name</span>
                        }
                        @PageList(VersionPages)
                    </nav>
                }
            </aside>

            <main class="wiki-main">
                @if (mdSource != null)
                {
                    <Web.Components.Markdown Content="@mdSource" />
                }
                else
                {
                    <p>Route not found; please check the URL and try again, or <a href="/wiki">go back to the wiki root</a>.</p>
                }
            </main>
        </div>
    }
}

@code {
    [Parameter]
    public string? Project { get; set; }

    [Parameter]
    public string? Route { get; set; }

    public WikiService.WikiProject? WikiProject;
    public WikiService.WikiVersion? Version;
    public string? ProjectName;
    public string PageSlug = "home";

    public List<WikiService.WikiPage> GlobalPages = [];
    public List<WikiService.WikiPage> VersionPages = [];

    public string? mdSource;

    public bool IsErrored = false;
    public bool IsLoading = true;
    public string? CustomError;

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UsePrism()
        .UseWikiLinks()
        .Build();

    protected override async Task OnParametersSetAsync()
    {
        IsErrored = false;
        CustomError = null;
        mdSource = null;

        var route = string.IsNullOrWhiteSpace(Route) ? "home" : Route.TrimEnd('/');

        if (string.IsNullOrEmpty(Project))
        {
            IsErrored = true;
            IsLoading = false;
            CustomError = "No project found.";
            return;
        }

        var projList = await Projects.GetProjects();
        var projectInfo = projList.FirstOrDefault(p => string.Equals(p.Slug, Project, StringComparison.OrdinalIgnoreCase));
        var wikiProject = Wiki.GetProject(Project);
        if (projectInfo.Slug is null || wikiProject is null)
        {
            IsErrored = true;
            IsLoading = false;
            CustomError = $"No project with the slug '{Project}' was found. Check the URL and try again.";
            return;
        }

        // Versioned routes are /wiki/{project}/{version}/{page}
        var version = wikiProject.DefaultVersion;
        if (wikiProject.IsVersioned)
        {
            var segments = route.Split('/', 2);
            if (wikiProject.GetVersion(segments[0]) is { } routeVersion)
            {
                version = routeVersion;
                route = segments.Length > 1 && !string.IsNullOrWhiteSpace(segments[1]) ? segments[1] : "home";
            }
            else
            {
                // No version in the URL (e.g. an older link): send it to the version that has the page
                var target = wikiProject.FindVersionWithPage(route) ?? wikiProject.DefaultVersion;
                Nav.NavigateTo(wikiProject.Url(target, route), replace: true);
                return;
            }
        }

        WikiProject = wikiProject;
        Version = version;
        ProjectName = projectInfo.Name;
        PageSlug = route;
        GlobalPages = version.Pages.Values.Where(p => p.IsGlobal).ToList();
        VersionPages = version.Pages.Values.Where(p => !p.IsGlobal).ToList();
        if (version.Pages.TryGetValue(route, out var page))
        {
            var source = await Wiki.ReadPage(page);
            if (source is null)
            {
                IsErrored = true;
                CustomError = "Failed to load the requested page.";
            }
            else
            {
                var linkContext = WikiLinkExtension.CreateContext(target => wikiProject.ResolveLink(version, target));
                mdSource = Markdig.Markdown.ToHtml(source, Pipeline, linkContext);
            }
        }

        IsLoading = false;
    }

    private void OnVersionChanged(ChangeEventArgs e)
    {
        if (WikiProject?.GetVersion(e.Value as string ?? "") is not { } version)
            return;

        // Stay on the same page when the new version has it
        var slug = version.Pages.ContainsKey(PageSlug) ? PageSlug : "home";
        Nav.NavigateTo(WikiProject.Url(version, slug));
    }

    private RenderFragment PageList(IEnumerable<WikiService.WikiPage> pages) => @<ul>
        @foreach (var group in pages.GroupBy(x => x.Folder).OrderBy(g => g.Key))
        {
            @if (group.Key is null)
            {
                @foreach (var p in group.OrderBy(x => x.Slug))
                {
                    <li><a href="@WikiProject!.Url(Version!, p.Slug)">@p.Title</a></li>
                }
            }
            else
            {
                <li>
                    <span class="wiki-nav-folder">@group.Key</span>
                    <ul>
                        @foreach (var p in group.OrderBy(x => x.Slug))
                        {
                            <li><a href="@WikiProject!.Url(Version!, p.Slug)">@p.Title</a></li>
                        }
                    </ul>
                </li>
            }
        }
    </ul>;
}
